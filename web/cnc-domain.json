  "rules": [
    {
      "ruleId": "CNC-R001",
      "version": "1.0.0",
      "title": "Internal corner radius is below the demonstrated tool clearance",
      "severity": "high",
      "featureId": "inside-pocket-corner",
      "calculation": { "kind": "minimum", "measurementKey": "insideRadiusMm", "threshold": 3.5, "unit": "mm" },
      "consequence": "The selected 3.0 mm cutter cannot produce the 1.0 mm internal radius without a tool or geometry change.",
      "recommendation": "Increase the inside corner radius to 3.5 mm for this controlled fixture.",
      "evidenceReferences": ["fixture://BRKT-001/B/features/inside-pocket-corner", "ruleset://cnc-demo-1.0.0/CNC-R001"]
    },
    {
      "ruleId": "CNC-R002",
      "version": "1.0.0",
      "title": "Pocket depth-to-width ratio exceeds the demonstration threshold",
      "severity": "medium",
      "featureId": "deep-pocket",
      "calculation": { "kind": "maximum_ratio", "numeratorKey": "depthMm", "denominatorKey": "minWidthMm", "threshold": 3.0, "unit": "ratio" },
      "consequence": "The narrow, deep pocket increases tool deflection and access risk in the controlled process model.",
      "recommendation": "Reduce pocket depth, increase its minimum width, or review a different machining strategy.",
      "evidenceReferences": ["fixture://BRKT-001/B/features/deep-pocket", "ruleset://cnc-demo-1.0.0/CNC-R002"]
    },
    {
      "ruleId": "CNC-R003",
      "version": "1.0.0",
      "title": "Wall thickness is below the aluminum demonstration threshold",
      "severity": "high",
      "featureId": "thin-wall",
      "calculation": { "kind": "minimum", "measurementKey": "thicknessMm", "threshold": 1.5, "unit": "mm" },
      "consequence": "The wall is more susceptible to deflection, chatter, or damage during the controlled CNC scenario.",
      "recommendation": "Increase the wall thickness to at least 1.5 mm or request an engineering review.",
      "evidenceReferences": ["fixture://BRKT-001/B/features/thin-wall", "ruleset://cnc-demo-1.0.0/CNC-R003"]
    },
    {
      "ruleId": "CNC-R004",
      "version": "1.0.0",
      "title": "Drilled-hole depth-to-diameter ratio exceeds the demonstration threshold",
      "severity": "medium",
      "featureId": "deep-drilled-hole",
      "calculation": { "kind": "maximum_ratio", "numeratorKey": "depthMm", "denominatorKey": "diameterMm", "threshold": 4.0, "unit": "ratio" },
      "consequence": "The hole may require specialized drilling cycles, chip evacuation, or additional setup in this model.",
      "recommendation": "Reduce the hole depth, increase its diameter, or review a deep-hole drilling process.",
      "evidenceReferences": ["fixture://BRKT-001/B/features/deep-drilled-hole", "ruleset://cnc-demo-1.0.0/CNC-R004"]
    },
    {
      "ruleId": "CNC-R005",
      "version": "1.0.0",
      "title": "Mounting-hole tolerance is tighter than the default demonstration capability",
      "severity": "medium",
      "featureId": "mounting-hole-tolerance",
      "calculation": { "kind": "minimum", "measurementKey": "tolerancePlusMinusMm", "threshold": 0.05, "unit": "mm" },
      "consequence": "The tolerance may add inspection, finishing, and cost without a documented functional need.",
      "recommendation": "Relax the tolerance to ±0.05 mm or record the functional requirement for supplier review.",
      "evidenceReferences": ["fixture://BRKT-001/B/features/mounting-hole-tolerance", "ruleset://cnc-demo-1.0.0/CNC-R005"]
    }
  ]
