# Optional live Onshape design source.
#
# BuildReady runs its complete workflow without these values: the controlled
# BRKT-001-B fixture is the default and the judge path. Setting them additionally
# enables the "Load live Onshape model" control and the load_onshape_design tool.
#
# Local development reads these from the environment (scripts/serve.py).
# Production reads them from Cloudflare Pages secrets, never from this file.
# Never commit real keys: .env is gitignored, .env.example is not.

# Create at https://dev-portal.onshape.com/keys with read-only scopes.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# From the document URL:
# https://cad.onshape.com/documents/{DOCUMENT_ID}/w/{WORKSPACE_ID}/e/{ELEMENT_ID}
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=
ONSHAPE_ELEMENT_ID=

# These three IDs are for the live viewer's workspace URL, not a frozen export.
# Extract them without contacting Onshape:
# uv run python scripts/integration_preflight.py --onshape-url "YOUR_WORKSPACE_PART_STUDIO_URL"
# Then copy the printed IDs here in your local .env, never into this template.

# Optional comma-separated document allowlist for the Onshape extension panel.
# The fixed ONSHAPE_DOCUMENT_ID above is always allowed. Browser-supplied
# context is rejected unless its document appears in this set.
ONSHAPE_ALLOWED_DOCUMENT_IDS=

# Override only for an enterprise Onshape instance.
# ONSHAPE_BASE_URL=https://cad.onshape.com

# Optional SimScale account preflight. This key stays server-side and is used
# by the read-only preflight commands until the live verification gate passes.
SIMSCALE_API_KEY=
SIMSCALE_PROJECT_ID=

# Offline configuration check (prints names of missing fields, never keys):
# uv run python scripts/integration_preflight.py
# Read-only checks; no CAD uploads or simulations:
# uv run python scripts/integration_preflight.py --check-simscale
# uv run python scripts/integration_preflight.py --check-onshape

# Maximum exact-revision STEP artifact accepted by the server-side transport.
FEA_MAX_CAD_BYTES=26214400

# The application remains in recorded mode by default. Do not set this to
# simscale during setup. Live integration is unfinished. The user requires $0
# spending; a successful read does not approve transfers or compute.
SIMULATION_PROVIDER=recorded
