# Optional live Onshape design source.
#
# BuildReady runs its complete workflow without these values: the controlled
# BRKT-001-B fixture is the default and the judge path. Setting them additionally
# enables the "Load live Onshape model" control and the load_onshape_design tool.
#
# Local development reads these from the environment (scripts/serve.py).
# Production reads them from Cloudflare Pages secrets, never from this file.
# Never commit real keys: .env is gitignored, .env.example is not.

# Create at https://dev-portal.onshape.com/keys with read-only scopes.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# From the document URL:
# https://cad.onshape.com/documents/{DOCUMENT_ID}/w/{WORKSPACE_ID}/e/{ELEMENT_ID}
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=
ONSHAPE_ELEMENT_ID=

# Override only for an enterprise Onshape instance.
# ONSHAPE_BASE_URL=https://cad.onshape.com
